#!name=防开屏
#!desc=15 款 iOS App 的开屏广告过滤｜修订 2

[Rule]
# QQ 音乐：广告投放与素材主机，指定主机的 QUIC 连接回退到 TCP
DOMAIN,tmead.y.qq.com,REJECT
DOMAIN,tmeadquic.y.qq.com,REJECT
DOMAIN,adcdn6.tencentmusic.com,REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,music.y.qq.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,y.gtimg.cn)),REJECT

# 酷安：恢复此前实测通过的 V1.3 广告域名规则
DOMAIN,pgdt.ugdtimg.com,REJECT
DOMAIN,sdk-config.tanx.com,REJECT
DOMAIN,et.tanx.com,REJECT

# 汽水音乐：恢复此前实测通过的 V1.3 广告投放与素材规则
DOMAIN,ads5-normal-hl.zijieapi.com,REJECT
DOMAIN,adsmind.ugdtimg.com,REJECT

# 网易云音乐：拦截广告图片和视频素材主机，保留广告权益 API
# 来源 https://github.com/zbsdsb/loon-adblock-plugins/blob/main/NeteaseCloudMusic_splash_patch.lpx
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT

[URL Rewrite]
# QQ 音乐：广告下发和素材路径
# 来源 https://github.com/Moli-X/Resources/blob/main/Rewrite/ADBlock.conf
^https?://music\.y\.qq\.com/maproxy/getPbCompressAd(?:[/?]|$) - reject
^https?://y\.gtimg\.cn/music/common/upload/t_splash_info/ - reject-img
^https?://y\.gtimg\.cn/music/common/upload/(?:kg_ad|targeted_ads) - reject-img

# 网易云音乐：V1.3 的开屏配置、预取和活动素材接口
^https?://interface3\.music\.163\.com/eapi/ad/(?:loading/current|prefetch/select|iyunIds)(?:[/?#]|$) - reject-dict

# 哔哩哔哩：V1.3 的开屏视频文件名
^https?://upos-sz-static\.bilivideo\.com/ssaxcode/[^?#]*-SPLASH\.mp4(?:[?#]|$) - reject

# 百度贴吧：开屏广告下发
# 来源 https://github.com/app2smile/rules/blob/master/module/tieba.sgmodule
^https?://(?:tiebac|c\.tieba)\.baidu\.com/c/f/ad/getSplashAd(?:\?|$) - reject

# 微博：开屏预加载和实时广告
# 来源 https://github.com/osuphi/shadowrocket-startup-ads/blob/main/StartupAds.module
^https?://bootpreload\.uve\.weibo\.com/v\d+/ad/preload(?:\?|$) - reject-dict
^https?://bootrealtime\.uve\.weibo\.com/v\d+/ad/realtime(?:\?|$) - reject-dict

# 高德地图：启动广告和开屏实时投放
# 来源 https://github.com/osuphi/shadowrocket-startup-ads/blob/main/StartupAds.module
^https?://m5\.amap\.com/ws/shield/dsp/app/startup/init(?:\?|$) - reject-dict
^https?://amap-aos-info-nogw\.amap\.com/ws/aos/alimama/splash_screen_rt(?:\?|$) - reject

# 百度地图：仅匹配 phpui2 接口的 qt=ads 请求
# 来源 https://github.com/BlueGrave/Shadowrocket/blob/master/sRocket.conf
^https?://newclient\.map\.baidu\.com/client/phpui2/?\?(?:[^#]*&)?qt=ads(?:&|$) - reject-dict

# 闲鱼：冷启动广告和素材预取，含旧版淘宝网关
# 来源 https://github.com/Thelongdarkorg/loon-plugins/blob/main/xianyu_splash_ad_block.plugin
^https?://acs\.m\.goofish\.com/gw/mtop\.taobao\.idlecommerce\.splash\.(?:async\.)?ads(?:/|\?|$) - reject-200
^https?://acs\.m\.taobao\.com/gw/mtop\.taobao\.idlecommerce\.splash\.ads(?:/|\?|$) - reject-200

# 拼多多：开屏广告下发
# 来源 https://github.com/BlueGrave/Shadowrocket/blob/master/sRocket.conf
^https?://api\.(?:pinduoduo|yangkeduo)\.com/api/cappuccino/splash(?:\?|$) - reject

[Body Rewrite]
# 酷安：沿用实测版本，仅过滤初始化响应中的 945 卡片
http-response-jq ^https?://api\.coolapk\.com/v6/main/init(?:[/?]|$) 'if (.data | type) == "array" then .data |= map(select((.entityId | tostring) != "945")) else . end'

# 哔哩哔哩：清空开屏展示列表，保留响应状态
# 来源 https://github.com/osuphi/shadowrocket-startup-ads/blob/main/StartupAds.module
http-response-jq ^https?://app\.bilibili\.com/x/v2/splash/(?:list|show|event/list2)(?:\?|$) 'if type == "object" and (.data | type) == "object" then .data |= (reduce ("show", "event_list", "list") as $key (. ; if (.[$key] | type) == "array" then .[$key] = [] else . end)) else . end'

# 知乎：将开屏时长归零，兼容响应内嵌的 JSON 字符串
# 来源 https://github.com/osuphi/shadowrocket-startup-ads/blob/main/StartupAds.module
http-response-jq ^https?://api\.zhihu\.com/commercial_api/(?:launch_v2|real_time_launch_v2)(?:\?|$) 'def clear: if type == "array" then map(clear) elif type == "object" then map_values(clear) | (if (.img_play_duration | type) == "number" then .img_play_duration = 0 else . end) | (if (.launch_timeout | type) == "number" then .launch_timeout = 0 else . end) elif type == "string" and (contains("img_play_duration") or contains("launch_timeout")) then . as $original | try (fromjson | clear | tojson) catch $original else . end; clear'

# 小红书：从开屏配置和通用配置中移除开屏字段
# 来源 https://github.com/osuphi/shadowrocket-startup-ads/blob/main/StartupAds.module
http-response-jq ^https?://edith\.(?:xiaohongshu|rnote)\.com/api/sns/v\d+/system_service/(?:splash_config|config)(?:\?|$) 'if type == "object" and (.data | type) == "object" then .data |= (del(.splash, .loading_img) | if (.ads_groups | type) == "array" then .ads_groups = [] else . end) else . end'

# 京东：仅处理 URL 带 functionId=start 的明文开屏响应
# 来源 https://github.com/osuphi/shadowrocket-startup-ads/blob/main/StartupAds.module
# 新版 POST 编码协议尚未覆盖 https://github.com/zbsdsb/loon-adblock-plugins
http-response-jq ^https?://api\.m\.jd\.com/client\.action\?(?:[^#]*&)?functionId=start(?:&|$) 'if type == "object" then with_entries(if .key == "images" and (.value | type) == "array" then .value = [] elif .key == "showTimesDaily" and (.value | type) == "number" then .value = 0 else . end) else . end'

# 淘宝：清空指定开屏位素材，也覆盖闲鱼共用的这个接口
# 来源 https://github.com/osuphi/shadowrocket-startup-ads/blob/main/StartupAds.module
http-response-jq ^https?://guide-acs\.m\.taobao\.com/gw/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(?:/|\?|$) 'walk(if type == "object" and (."taobao-splash" | type) == "object" and (."taobao-splash".data | type) == "array" then ."taobao-splash".data = [] else . end)'

[MITM]
# HTTPS 重写使用当前配置的 HTTPS 解密设置
hostname = %APPEND% y.gtimg.cn, music.y.qq.com, interface3.music.163.com, upos-sz-static.bilivideo.com, tiebac.baidu.com, c.tieba.baidu.com, bootpreload.uve.weibo.com, bootrealtime.uve.weibo.com, m5.amap.com, amap-aos-info-nogw.amap.com, newclient.map.baidu.com, acs.m.goofish.com, acs.m.taobao.com, api.pinduoduo.com, api.yangkeduo.com, api.coolapk.com, app.bilibili.com, api.zhihu.com, edith.xiaohongshu.com, edith.rnote.com, api.m.jd.com, guide-acs.m.taobao.com
